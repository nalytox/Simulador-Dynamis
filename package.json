{
  "name": "simulador-dynamis",
  "version": "0.1.0",
  "description": "Simulador web del robot de Dynamis (ESP32) para estudiantes",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "nucleo": "node scripts/construir-nucleo.mjs",
    "medir": "vitest run --config vitest.medicion.config.ts",
    "dev": "npm run nucleo && vite",
    "build": "npm run nucleo && vite build",
    "preview": "vite preview",
    "e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalytox/Simulador-Dynamis.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nalytox/Simulador-Dynamis/issues"
  },
  "homepage": "https://github.com/nalytox/Simulador-Dynamis#readme",
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@yowasp/clang": "22.0.0-git20542-10",
    "codemirror": "^6.0.2",
    "fflate": "^0.8.3",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
