{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "vitest.config.ts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
